% 葛藤・非決定ループ（縦レムニスケート束）: pt重複修正版
\NewEnviron{ConflictLoop}[1][\mathrm{conflict}]{%
  \begin{tikzpicture}[baseline=(m.center)]
    % 内部の連立状態・対立仮説を組版
    \node[inner sep=4pt, align=left] (m) {
      $\begin{aligned}
        \BODY
      \end{aligned}$
    };
    
    % バウンディングボックスの座標取得 (\topY, \botY には最初から pt が付いている)
    \path (m.north west); \pgfgetlastxy{\dummy}{\topY}
    \path (m.south west); \pgfgetlastxy{\dummy}{\botY}
    
    % pgfmath で数値計算 (結果の \midY, \loopH は単位なしの数値になる)
    \pgfmathsetmacro{\midY}{(\topY + \botY) / 2}
    \pgfmathsetmacro{\loopH}{(\topY - \botY) / 4}
    \pgfmathsetmacro{\w}{8.5} % ループの横幅（pt単位）
    
    % 縦向き無限大（8の字）
    % \topY と \botY はそのまま使用、\midY や \loopH にのみ pt を付与
    \draw[
      line width=0.85pt,
      postaction={decorate},
      decoration={
        markings,
        mark=at position 0.22 with {\arrow[scale=0.8]{Stealth}},
        mark=at position 0.72 with {\arrow[scale=0.8]{Stealth}}
      }
    ]
      (-10pt, \midY pt)
      .. controls (-10pt - \w pt, \midY pt + \loopH pt * 0.6) and (-10pt - \w pt, \topY) .. (-10pt, \topY)
      .. controls (-10pt + \w pt, \topY) and (-10pt + \w pt, \midY pt + \loopH pt * 0.6) .. (-10pt, \midY pt)
      .. controls (-10pt - \w pt, \midY pt - \loopH pt * 0.6) and (-10pt - \w pt, \botY) .. (-10pt, \botY)
      .. controls (-10pt + \w pt, \botY) and (-10pt + \w pt, \midY pt - \loopH pt * 0.6) .. cycle;

    % 特異点・葛藤ラベル
    \node[left=6pt, at={(-10pt - \w pt, \midY pt)}, font=\scriptsize] {$#1$};
  \end{tikzpicture}%
}


